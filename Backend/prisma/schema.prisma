generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Student {
  student_id      String              @id @default(uuid()) @db.VarChar(36)
  first_name      String              @db.VarChar(100)
  last_name       String              @db.VarChar(100)
  date_of_birth   DateTime?
  gender          Gender?
  user_id         String              @unique @db.VarChar(36)
  phone_number    String?             @db.VarChar(35)
  email           String?             @db.VarChar(100)
  secondary_email String?             @db.VarChar(100)
  address         String?             @db.Text
  nationality     String?             @db.VarChar(50)
  language        String?             @db.VarChar(50)
  avatar_url      String?             @db.Text
  education_level String?             @db.VarChar(100)
  study_location  String?             @db.VarChar(100)
  status          StudentStatus       @default(ACTIVE)
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  attendance      Attendance[]
  documents       Document[]          @relation("StudentDocuments")
  enrollments     Enrollment[]
  fees            Fee[]
  results         Result[]
  permissions     StudentPermission[]
  user            User?

  registrant_category RegistrantCategory @default(STUDENT)

  @@map("Student")
}

model Teacher {
  teacher_id   String   @id @default(uuid()) @db.VarChar(36)
  first_name   String   @db.VarChar(100)
  last_name    String   @db.VarChar(100)
  email        String?  @db.VarChar(100)
  phone_number String?  @db.VarChar(35)
  created_at   DateTime @default(now())
  groups       Group[]
  user         User?

  @@map("Teacher")
}

model Course {
  course_id     String         @id @default(uuid()) @db.VarChar(36)
  course_code   String?        @unique @db.VarChar(20)
  course_name   String         @db.VarChar(100)
  credits       Int?
  fee_amount    Decimal?       @default(1000) @db.Decimal(10, 2)
  profile       CourseProfile?
  enrollments   Enrollment[]
  exams         Exam[]
  groups        Group[]
  notifications Notification[]

  @@map("Course")
}

model CourseProfile {
  profile_id        String          @id @default(uuid()) @db.VarChar(36)
  course_id         String          @unique @db.VarChar(36)
  title_ar          String?         @db.VarChar(200)
  description       String?         @db.Text
  description_ar    String?         @db.Text
  language          String?         @db.VarChar(50)
  level             String?         @db.VarChar(20)
  flag_emoji        String?         @db.VarChar(10)
  price             Decimal?        @default(0) @db.Decimal(10, 2)
  currency          String?         @default("DZD") @db.VarChar(10)
  session_name      String?         @db.VarChar(100)
  start_date        DateTime?
  end_date          DateTime?
  registration_open Boolean         @default(true)
  is_published      Boolean         @default(false)
  image_url         String?         @db.Text
  image_public_id   String?         @db.VarChar(255)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  pricing           CoursePricing[]
  course            Course          @relation(fields: [course_id], references: [course_id], onDelete: Cascade)

  @@map("CourseProfile")
}

model CoursePricing {
  pricing_id  String        @id @default(uuid()) @db.VarChar(36)
  profile_id  String        @db.VarChar(36)
  status_fr   String        @db.VarChar(200)
  status_ar   String?       @db.VarChar(200)
  status_en   String?       @db.VarChar(200)
  price       Decimal       @default(0) @db.Decimal(10, 2)
  currency    String        @default("DA") @db.VarChar(10)
  discount    String?       @db.VarChar(100)
  sort_order  Int           @default(0)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  profile     CourseProfile @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade)
  enrollments Enrollment[]

  @@map("CoursePricing")
}

model Department {
  department_id String   @id @default(uuid()) @db.VarChar(36)
  name          String   @unique @db.VarChar(100)
  description   String?  @db.Text
  created_at    DateTime @default(now())
  groups        Group[]

  @@map("Department")
}

model Group {
  group_id      String         @id @default(uuid()) @db.VarChar(36)
  name          String         @db.VarChar(255)
  department_id String?        @db.VarChar(36)
  course_id     String         @db.VarChar(36)
  max_students  Int            @default(25)
  status        GroupStatus    @default(OPEN)
  teacher_id    String?        @db.VarChar(36)
  level         Level
  enrollments   Enrollment[]
  course        Course         @relation(fields: [course_id], references: [course_id])
  department    Department?    @relation(fields: [department_id], references: [department_id])
  teacher       Teacher?       @relation(fields: [teacher_id], references: [teacher_id])
  notifications Notification[]
  sessions      Session[]

  @@map("Group")
}

model Enrollment {
  enrollment_id       String                @id @default(uuid()) @db.VarChar(36)
  student_id          String                @db.VarChar(36)
  course_id           String                @db.VarChar(36)
  group_id            String?               @db.VarChar(36)
  enrollment_date     DateTime              @default(now())
  level               Level?
  start_date          DateTime?
  end_date            DateTime?
  registration_status RegistrationStatus    @default(PENDING)
  pricing_id          String?               @db.VarChar(36)
  course              Course                @relation(fields: [course_id], references: [course_id])
  group               Group?                @relation(fields: [group_id], references: [group_id])
  pricing             CoursePricing?        @relation(fields: [pricing_id], references: [pricing_id])
  student             Student               @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  fees                Fee[]
  history             RegistrationHistory[]

  @@unique([student_id, course_id])
  @@map("Enrollment")
}

model Session {
  session_id   String       @id @default(uuid()) @db.VarChar(36)
  group_id     String       @db.VarChar(36)
  session_date DateTime
  topic        String?      @db.VarChar(255)
  room_id      String?      @db.VarChar(36)
  end_time     DateTime?
  attendance   Attendance[]
  group        Group        @relation(fields: [group_id], references: [group_id])
  room         Room?        @relation(fields: [room_id], references: [room_id])

  @@map("Session")
}

model Room {
  room_id    String    @id @default(uuid()) @db.VarChar(36)
  name       String    @unique @db.VarChar(255)
  capacity   Int       @default(30)
  location   String?   @db.VarChar(255)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  sessions   Session[]

  @@map("Room")
}

model Attendance {
  attendance_id String           @id @default(uuid()) @db.VarChar(36)
  session_id    String           @db.VarChar(36)
  student_id    String           @db.VarChar(36)
  status        AttendanceStatus
  attended_at   DateTime         @default(now())
  session       Session          @relation(fields: [session_id], references: [session_id])
  student       Student          @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([session_id, student_id])
  @@map("Attendance")
}

model Exam {
  exam_id   String   @id @default(uuid()) @db.VarChar(36)
  course_id String   @db.VarChar(36)
  exam_name String?  @db.VarChar(255)
  exam_date DateTime
  max_marks Int
  course    Course   @relation(fields: [course_id], references: [course_id])
  results   Result[]

  @@map("Exam")
}

model Result {
  result_id      String  @id @default(uuid()) @db.VarChar(36)
  exam_id        String  @db.VarChar(36)
  student_id     String  @db.VarChar(36)
  marks_obtained Int
  grade          String? @db.VarChar(10)
  exam           Exam    @relation(fields: [exam_id], references: [exam_id], onDelete: Cascade)
  student        Student @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([exam_id, student_id])
  @@map("Result")
}

model Fee {
  fee_id            String      @id @default(uuid()) @db.VarChar(36)
  student_id        String      @db.VarChar(36)
  enrollment_id     String?     @db.VarChar(36)
  amount            Decimal     @db.Decimal(10, 2)
  due_date          DateTime
  status            FeeStatus   @default(UNPAID)
  payment_method    String?     @db.VarChar(30)
  reference_code    String?     @db.VarChar(100)
  paid_at           DateTime?
  created_by        String?     @db.VarChar(36)
  processed_at      DateTime?
  processed_by      String?     @db.VarChar(36)
  confirmed_by      String?     @db.VarChar(36)
  confirmed_by_user User?       @relation("FeeConfirmedBy", fields: [confirmed_by], references: [user_id])
  enrollment        Enrollment? @relation(fields: [enrollment_id], references: [enrollment_id])
  student           Student     @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("Fee")
}

model Document {
  document_id String         @id @default(uuid()) @db.VarChar(36)
  student_id  String         @db.VarChar(36)
  type        String         @db.VarChar(50)
  file_path   String         @db.Text
  public_id   String?        @db.VarChar(255)
  status      DocumentStatus @default(PENDING)
  reviewed_at DateTime?
  reviewed_by String?        @db.VarChar(36)
  uploaded_at DateTime       @default(now())
  student     Student        @relation("StudentDocuments", fields: [student_id], references: [student_id])

  @@map("Document")
}

model Permission {
  permission_id String              @id @default(uuid()) @db.VarChar(36)
  name          String              @unique @db.VarChar(255)
  description   String?             @db.Text
  students      StudentPermission[]

  @@map("Permission")
}

model StudentPermission {
  student_id    String     @db.VarChar(36)
  permission_id String     @db.VarChar(36)
  permission    Permission @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade)
  student       Student    @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@id([student_id, permission_id])
  @@map("StudentPermission")
}

model RegistrationHistory {
  history_id    String             @id @default(uuid()) @db.VarChar(36)
  enrollment_id String             @db.VarChar(36)
  old_status    RegistrationStatus
  new_status    RegistrationStatus
  changed_at    DateTime           @default(now())
  changed_by    String?            @db.VarChar(36)
  enrollment    Enrollment         @relation(fields: [enrollment_id], references: [enrollment_id], onDelete: Cascade)

  @@map("RegistrationHistory")
}

model User {
  user_id        String                  @id @default(uuid()) @db.VarChar(36)
  email          String                  @unique @db.VarChar(100)
  password       String?                 @db.VarChar(255)
  role           UserRole                @default(STUDENT)
  is_active      Boolean                 @default(true)
  google_id      String?                 @unique @db.VarChar(255)
  google_email   String?                 @db.VarChar(100)
  google_avatar  String?                 @db.Text
  student_id     String?                 @unique @db.VarChar(36)
  teacher_id     String?                 @unique @db.VarChar(36)
  created_at     DateTime                @default(now())
  confirmed_fees Fee[]                   @relation("FeeConfirmedBy")
  notifications  NotificationRecipient[]
  refresh_tokens RefreshToken[]
  student        Student?                @relation(fields: [student_id], references: [student_id])
  teacher        Teacher?                @relation(fields: [teacher_id], references: [teacher_id])

  @@map("User")
}

model RefreshToken {
  token_id   String   @id @default(uuid()) @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  token      String   @unique @db.VarChar(500)
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("RefreshToken")
}

model Announcement {
  announcement_id String    @id @default(uuid()) @db.VarChar(36)
  title           String    @db.VarChar(255)
  title_ar        String?   @db.VarChar(255)
  content         String    @db.Text
  content_ar      String?   @db.Text
  excerpt         String?   @db.VarChar(500)
  excerpt_ar      String?   @db.VarChar(500)
  category        String?   @db.VarChar(50)
  image_url       String?   @db.Text
  image_public_id String?   @db.VarChar(255)
  is_published    Boolean   @default(false)
  published_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  is_pinned       Boolean   @default(false)
  pinned_at       DateTime?

  @@map("announcements")
}

model Notification {
  notification_id String                  @id @default(uuid()) @db.VarChar(36)
  title           String                  @db.VarChar(200)
  title_ar        String?                 @db.VarChar(200)
  message         String                  @db.Text
  message_ar      String?                 @db.Text
  target_type     NotificationTarget
  course_id       String?                 @db.VarChar(36)
  group_id        String?                 @db.VarChar(36)
  priority        NotificationPriority    @default(NORMAL)
  created_by      String?                 @db.VarChar(36)
  created_at      DateTime                @default(now())
  course          Course?                 @relation(fields: [course_id], references: [course_id])
  group           Group?                  @relation(fields: [group_id], references: [group_id])
  recipients      NotificationRecipient[]

  @@map("Notification")
}

model NotificationRecipient {
  recipient_id    String       @id @default(uuid()) @db.VarChar(36)
  notification_id String       @db.VarChar(36)
  user_id         String       @db.VarChar(36)
  is_read         Boolean      @default(false)
  read_at         DateTime?
  notification    Notification @relation(fields: [notification_id], references: [notification_id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([notification_id, user_id])
  @@index([user_id, is_read])
  @@map("NotificationRecipient")
}

model AuditLog {
  log_id      String   @id @default(uuid()) @db.VarChar(36)
  user_id     String?  @db.VarChar(36)
  user_email  String?  @db.VarChar(100)
  user_role   String?  @db.VarChar(20)
  action      String   @db.VarChar(50)
  entity_type String   @db.VarChar(50)
  entity_id   String?  @db.VarChar(100)
  details     String?  @db.Text
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([action])
  @@index([entity_type])
  @@index([created_at])
  @@map("AuditLog")
}

model SystemSettings {
  setting_id String   @id @default(uuid()) @db.VarChar(36)
  key        String   @unique @db.VarChar(100)
  value      String   @db.Text
  updated_by String?  @db.VarChar(36)
  updated_at DateTime @updatedAt

  @@map("SystemSettings")
}

enum NotificationTarget {
  ALL_STUDENTS
  ALL_TEACHERS
  SPECIFIC_STUDENTS
  SPECIFIC_TEACHERS
  GROUP
  COURSE
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum GroupStatus {
  OPEN
  FULL
  FINISHED
}

enum UserRole {
  ADMIN
  STUDENT
  TEACHER
  OWNER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum FeeStatus {
  PAID
  UNPAID
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RegistrationStatus {
  PENDING
  VALIDATED
  REJECTED
  PAID
  FINISHED
}

enum RegistrantCategory {
  STUDENT
  EXTERNAL
  EMPLOYEE
}

enum DocumentType {
  PHOTO
  ID_CARD
  STUDENT_CARD
  SCHOOL_CERTIFICATE
  REGISTRATION_CERTIFICATE
  WORK_CERTIFICATE
  ADMIN_CERTIFICATE
  PAYMENT_RECEIPT
}

enum Level {
  BASICS
  A1
  A2
  B1
  B2
  C1
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}
